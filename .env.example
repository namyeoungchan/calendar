# Public URL used for OAuth callbacks and shared calendar links.
# Local development:
APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Generate an unpredictable value of at least 32 characters.
AUTH_SECRET=replace_with_a_long_random_value

# Kakao Developers app keys.
KAKAO_REST_API_KEY=replace_with_rest_api_key
KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=replace_with_javascript_key

# Firebase Admin credentials. On Vercel, prefer the complete JSON value.
FIREBASE_SERVICE_ACCOUNT_JSON=replace_with_complete_service_account_json
# Or use the three fields below instead.
# FIREBASE_PROJECT_ID=wedding-e106b
# FIREBASE_CLIENT_EMAIL=replace_with_service_account_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"

# Existing Firebase web app used for email authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_web_api_key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wedding-e106b
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wedding-e106b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=replace_with_web_app_id

# Existing Data Connect connector. Keeping these values shares calendar data
# with the wedding-planner application.
FIREBASE_DATA_CONNECT_SERVICE_ID=wedding-admin
FIREBASE_DATA_CONNECT_LOCATION=asia-northeast3
FIREBASE_DATA_CONNECT_CONNECTOR_ID=wedding-server
